          account: "871122334",
          date: "20/09/2026, 10:30",
          amount: 24700.00,
          fee: 370.50,
          net: 24329.50,
          status: "Concluído"
        }
      ]
    };

    /* ===================================================================
       UTILITÁRIOS E FORMATAÇÃO
       =================================================================== */
    function formatMZN(val) {
      if (typeof val !== 'number' || isNaN(val)) return '0,00';
      return val.toLocaleString('pt-MZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    /* ===================================================================
       ATUALIZAÇÃO DA INTERFACE DADOS & MÉTRICAS
       =================================================================== */
    function updateMetricsUI() {
      document.getElementById('totalBalanceDisplay').innerText = formatMZN(appState.balance);
      document.getElementById('maxBalanceBtnText').innerText = formatMZN(appState.balance) + ' MT';
      document.getElementById('pendingCountDisplay').innerText = appState.pendingCount;
      document.getElementById('pendingAmountDisplay').innerText = formatMZN(appState.pendingAmount) + ' MT';
      document.getElementById('completedTotalDisplay').innerText = formatMZN(appState.completedTotal);
      document.getElementById('completedCountDisplay').innerText = `${appState.completedCount} transações`;
      document.getElementById('profitDisplay').innerText = '+' + formatMZN(appState.balance * 0.1557) + ' MT';
    }

    /* ===================================================================
       INTEGRAÇÃO API COM BACKEND (RENDER.COM)
       =================================================================== */
    async function checkBackendHealth() {
      const dot = document.getElementById('apiStatusDot');
      const text = document.getElementById('apiStatusText');
      const banner = document.getElementById('apiInfoBanner');

      dot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 pulse-indicator mr-2";
      text.innerText = "A conectar ao backend...";

      try {
        const response = await fetch(`${BACKEND_URL}/api/withdrawals`, {
          method: 'GET',
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          appState.backendConnected = true;
          dot.className = "w-2.5 h-2.5 rounded-full bg-brand-400 mr-2";
          text.innerText = "Backend Conectado (Render)";
          banner.classList.remove('hidden');
          
          // Tentar carregar dados reais do backend
          await syncDataFromBackend();
        } else {
          throw new Error(`HTTP ${response.status}`);
        }
      } catch (err) {
        console.warn("Backend não respondeu ou em repouso. Operando no modo simulação.", err);
        appState.backendConnected = false;
        dot.className = "w-2.5 h-2.5 rounded-full bg-blue-400 mr-2";
        text.innerText = "Modo Simulação Local (Ativo)";
      }
    }

    async function syncDataFromBackend() {
      if (!appState.backendConnected) return;

      try {
        const response = await fetch(`${BACKEND_URL}/api/withdrawals`);
        if (response.ok) {
          const backendData = await response.json();
          if (Array.isArray(backendData) && backendData.length > 0) {
            // Mapeia o formato retornado pelo servidor
            appState.transactions = backendData.map(item => ({
              id: item.id || item._id || "TRX-" + Math.floor(1000 + Math.random() * 9000),
              method: item.paymentMethod || item.method || "M-Pesa",
              account: item.account || item.phoneNumber || "840000000",
              date: item.createdAt ? new Date(item.createdAt).toLocaleString('pt-MZ') : new Date().toLocaleString('pt-MZ'),
              amount: parseFloat(item.amount) || 0,
              fee: parseFloat(item.fee) || (parseFloat(item.amount) * 0.015),
              net: parseFloat(item.netAmount) || (parseFloat(item.amount) * 0.985),
              status: item.status || "Pendente"
            }));

            recalculateTotalsFromTransactions();
            renderHistoryTable();
            updateMetricsUI();
            showToast("Dados sincronizados com o backend!", "success");
          }
        }
      } catch (e) {
        console.error("Erro ao sincronizar do backend:", e);
      }
    }

    function recalculateTotalsFromTransactions() {
      let pendingCount = 0;
      let pendingSum = 0;
      let completedSum = 0;
      let completedCount = 0;

      appState.transactions.forEach(t => {
        if (t.status === 'Pendente' || t.status === 'Em Processamento') {
          pendingCount++;
          pendingSum += t.amount;
        } else if (t.status === 'Concluído') {
          completedCount++;
          completedSum += t.amount;
        }
      });

      appState.pendingCount = pendingCount;
      appState.pendingAmount = pendingSum;
      appState.completedTotal = completedSum;
      appState.completedCount = completedCount;
    }

    /* ===================================================================
       FORMULÁRIO & LÓGICA DE CAMPOS
       =================================================================== */
    function updateAccountFields() {
      const selected = document.querySelector('input[name="paymentMethod"]:checked').value;
      const accountLabel = document.getElementById('accountLabel');
      const accountInput = document.getElementById('accountInput');
      const accountIcon = document.getElementById('accountIcon');
      const accountHelpText = document.getElementById('accountHelpText');
      const timeEstimate = document.getElementById('timeEstimate');

      if (selected === 'M-Pesa') {
        accountLabel.innerText = "3. Número Vodacom (M-Pesa)";
        accountInput.placeholder = "84 / 85 XXX XXXX";
        accountIcon.className = "fa-solid fa-mobile-screen";
        accountHelpText.innerText = "Apenas números ativos na rede Vodacom Mozambique.";
        timeEstimate.innerText = "Instantâneo (Até 15 min)";
      } else if (selected === 'e-Mola') {
        accountLabel.innerText = "3. Número Movitel (e-Mola)";
        accountInput.placeholder = "86 / 87 XXX XXXX";
        accountIcon.className = "fa-solid fa-mobile-screen";
        accountHelpText.innerText = "Apenas números ativos na rede Movitel Mozambique.";
        timeEstimate.innerText = "Instantâneo (Até 15 min)";
      } else {
        accountLabel.innerText = "3. NIB ou Conta Bancária";
        accountInput.placeholder = "Ex: 000800001234567810145";
        accountIcon.className = "fa-solid fa-building-columns";
        accountHelpText.innerText = "NIB bancário de 21 dígitos para bancos moçambicanos.";
        timeEstimate.innerText = "1 a 2 Dias Úteis";
      }
    }

    function calculateFees() {
      const inputVal = parseFloat(document.getElementById('amountInput').value) || 0;
      const fee = inputVal * 0.015; // Taxa de 1.5%
      const net = Math.max(0, inputVal - fee);

      document.getElementById('feeDisplay').innerText = formatMZN(fee) + ' MT';
      document.getElementById('netAmountDisplay').innerText = formatMZN(net) + ' MT';
    }

    function setMaxAmount() {
      document.getElementById('amountInput').value = appState.balance;
      calculateFees();
    }

    async function handleWithdrawalSubmit(e) {
      e.preventDefault();

      const amount = parseFloat(document.getElementById('amountInput').value);
      const account = document.getElementById('accountInput').value.trim();
      const method = document.querySelector('input[name="paymentMethod"]:checked').value;

      // Validações
      if (amount > appState.balance) {
        showToast("Saldo insuficiente para cobrir o valor solicitado.", "error");
        return;
      }

      if (amount < 100) {
        showToast("O montante mínimo de levantamento é de 100,00 MT.", "error");
        return;
      }

      // Validação rápida de contacto telefónico moçambicano
      if ((method === 'M-Pesa' || method === 'e-Mola') && account.length < 8) {
        showToast("Insira um número de telefone válido com pelo menos 8 ou 9 dígitos.", "error");
        return;
      }

      const submitBtn = document.getElementById('submitBtn');
      const btnText = document.getElementById('btnText');
      const btnSpinner = document.getElementById('btnSpinner');

      submitBtn.disabled = true;
      btnText.innerText = "A Enviar Pedido...";
      btnSpinner.classList.remove('hidden');

      const fee = amount * 0.015;
      const net = amount - fee;
      const newRef = "TRX-" + Math.floor(10000 + Math.random() * 90000);
      const nowStr = new Date().toLocaleString('pt-MZ');

      const payload = {
        amount: amount,
        paymentMethod: method,
        account: account,
        fee: fee,
        netAmount: net,
        reference: newRef
      };

      let requestSuccess = false;

      // Se o backend estiver conectado, tentar enviar via POST
      if (appState.backendConnected) {
        try {
          const res = await fetch(`${BACKEND_URL}/api/withdrawals`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (res.ok) {
            requestSuccess = true;
            showToast("Pedido registado com sucesso no servidor Render!", "success");
          }
        } catch (err) {
          console.warn("Falha ao comunicar com o endpoint do servidor, alterando para processamento local.", err);
        }
      }

      // Se não enviou via API ou falhou, regista localmente de forma fluida
      setTimeout(() => {
        const newTransaction = {
          id: newRef,
          method: method,
          account: account,
          date: nowStr,
          amount: amount,
          fee: fee,
          net: net,
          status: "Pendente"
        };

        appState.balance -= amount;
        appState.pendingCount += 1;
        appState.pendingAmount += amount;
        appState.transactions.unshift(newTransaction);

        // Restaurar estado do botão
        submitBtn.disabled = false;
        btnText.innerText = "Confirmar e Solicitar Levantamento";
        btnSpinner.classList.add('hidden');

        // Limpar formulário
        document.getElementById('withdrawalForm').reset();
        calculateFees();
        updateMetricsUI();
        renderHistoryTable();

        if (!requestSuccess) {
          showToast(`Solicitação #${newRef} criada com sucesso!`, "success");
        }
      }, 1200);
    }

    /* ===================================================================
       SIMULADOR E CONTROLO DE TESTES
       =================================================================== */
    function updateSimulation() {
      const months = parseInt(document.getElementById('monthsRange').value);
      document.getElementById('monthsVal').innerText = months + (months === 1 ? ' Mês' : ' Meses');

      const monthlyRate = 0.018; // ~1.8%
      const projected = appState.balance * Math.pow((1 + monthlyRate), months);
      const profit = projected - appState.balance;

      document.getElementById('projectedBalance').innerText = formatMZN(projected) + ' MT';
      document.getElementById('projectedProfit').innerText = '+' + formatMZN(profit) + ' MT';
    }

    function toggleDevPanel() {
      const panel = document.getElementById('devPanel');
      panel.classList.toggle('hidden');
    }

    function addMockTransaction() {
      const mockMethods = ["M-Pesa", "e-Mola", "Transferência Bancária"];
      const mockStatus = ["Concluído", "Pendente", "Em Processamento"];
      const randomMethod = mockMethods[Math.floor(Math.random() * mockMethods.length)];
      const randomStatus = mockStatus[Math.floor(Math.random() * mockStatus.length)];
      const randomAmt = (Math.floor(Math.random() * 20) + 1) * 500;
      const randomFee = randomAmt * 0.015;

      const newTrx = {
        id: "TRX-" + Math.floor(10000 + Math.random() * 90000),
        method: randomMethod,
        account: randomMethod === "Transferência Bancária" ? "AO06004000" + Math.floor(100000 + Math.random() * 900000) : "84" + Math.floor(1000000 + Math.random() * 9000000),
        date: new Date().toLocaleString('pt-MZ'),
        amount: randomAmt,
        fee: randomFee,
        net: randomAmt - randomFee,
        status: randomStatus
      };

      appState.transactions.unshift(newTrx);
      recalculateTotalsFromTransactions();
      updateMetricsUI();
      renderHistoryTable();
      showToast("Transação demo adicionada com sucesso!", "success");
    }

    function simulateDeposit() {
      appState.balance += 20000;
      updateMetricsUI();
      updateSimulation();
      showToast("+20.000,00 MT creditados no Saldo Disponível!", "success");
    }

    function resetAppState() {
      appState.balance = 145850.00;
      syncDataFromBackend();
      showToast("Estado da aplicação restaurado.", "info");
    }

    /* ===================================================================
       TABELA E FILTRAGEM
       =================================================================== */
    function renderHistoryTable() {
      const tbody = document.getElementById('historyTableBody');
      const filterStatus = document.getElementById('filterStatus').value;
      const filterMethod = document.getElementById('filterMethod').value;
      const search = document.getElementById('searchHistory').value.toLowerCase().trim();

      const filtered = appState.transactions.filter(t => {
        const matchStatus = filterStatus === 'ALL' || t.status === filterStatus;
        const matchMethod = filterMethod === 'ALL' || t.method === filterMethod;
        const matchSearch = t.id.toLowerCase().includes(search) || 
                            t.method.toLowerCase().includes(search) || 
                            t.account.toLowerCase().includes(search);
        return matchStatus && matchMethod && matchSearch;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="py-10 text-center text-slate-500 text-xs">
              <i class="fa-solid fa-folder-open text-2xl mb-2 block"></i>
              Nenhuma transação encontrada para os critérios selecionados.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = filtered.map(t => {
        let badgeClass = "";
        if (t.status === 'Concluído') badgeClass = "bg-brand-950/80 text-brand-400 border-brand-800/60";
        else if (t.status === 'Pendente') badgeClass = "bg-amber-950/80 text-amber-400 border-amber-800/60";
        else if (t.status === 'Em Processamento') badgeClass = "bg-blue-950/80 text-blue-400 border-blue-800/60 animate-pulse";
        else badgeClass = "bg-rose-950/80 text-rose-400 border-rose-800/60";

        return `
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="py-3.5 px-3 font-mono text-slate-200 font-semibold">${t.id}</td>
            <td class="py-3.5 px-3">
              <span class="inline-flex items-center gap-1.5 font-medium">
                ${t.method === 'M-Pesa' ? '<span class="w-2 h-2 rounded-full bg-red-500"></span>' : ''}
                ${t.method === 'e-Mola' ? '<span class="w-2 h-2 rounded-full bg-orange-400"></span>' : ''}
                ${t.method === 'Transferência Bancária' ? '<span class="w-2 h-2 rounded-full bg-blue-400"></span>' : ''}
                ${t.method}
              </span>
            </td>
            <td class="py-3.5 px-3 font-mono text-slate-400">${t.account}</td>
            <td class="py-3.5 px-3 text-slate-400 text-[11px]">${t.date}</td>
            <td class="py-3.5 px-3 font-bold font-mono text-slate-100">${formatMZN(t.amount)} MT</td>
            <td class="py-3.5 px-3">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border ${badgeClass}">
                ${t.status}
              </span>
            </td>
            <td class="py-3.5 px-3 text-right">
              <button onclick="openModal('${t.id}')" class="text-slate-400 hover:text-brand-400 transition-colors text-xs p-1">
                <i class="fa-solid fa-eye mr-1"></i> Ver
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    /* ===================================================================
       MODAL DE COMPROVATIVO
       =================================================================== */
    function openModal(trxId) {
      const trx = appState.transactions.find(t => t.id === trxId);
      if (!trx) return;

      document.getElementById('modalRef').innerText = `REF: #${trx.id}`;
      const content = document.getElementById('modalContent');

      content.innerHTML = `
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Estado da Transação:</span>
          <span class="font-bold ${trx.status === 'Concluído' ? 'text-brand-400' : 'text-amber-400'}">${trx.status}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Método Escolhido:</span>
          <span class="font-semibold text-slate-200">${trx.method}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Conta / Telefone:</span>
          <span class="font-mono text-slate-200">${trx.account}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Data e Hora:</span>
          <span class="text-slate-200">${trx.date}</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Valor Bruto Solicitado:</span>
          <span class="font-mono text-slate-200">${formatMZN(trx.amount)} MT</span>
        </div>
        <div class="flex justify-between py-1.5 border-b border-slate-800">
          <span class="text-slate-400">Taxa do Serviço (1.5%):</span>
          <span class="font-mono text-slate-200">${formatMZN(trx.fee)} MT</span>
        </div>
        <div class="flex justify-between py-2 pt-3 font-bold text-sm">
          <span class="text-slate-300">Valor Líquido Transferido:</span>
          <span class="text-brand-400 font-mono text-base">${formatMZN(trx.net)} MT</span>
        </div>
      `;

      document.getElementById('detailsModal').classList.remove('hidden');
    }

    function closeModal() {
      document.getElementById('detailsModal').classList.add('hidden');
    }

    /* ===================================================================
       SISTEMA DE NOTIFICAÇÕES (TOASTS)
       =================================================================== */
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      let borderColor = 'border-brand-500';
      let iconColor = 'text-brand-400';
      let icon = 'fa-circle-check';

      if (type === 'error') {
        borderColor = 'border-rose-500';
        iconColor = 'text-rose-400';
        icon = 'fa-circle-exclamation';
      } else if (type === 'info') {
        borderColor = 'border-blue-500';
        iconColor = 'text-blue-400';
        icon = 'fa-circle-info';
      }

      toast.className = `glass-card ${borderColor} border text-white text-xs px-4 py-3.5 rounded-xl shadow-2xl flex items-center space-x-3 pointer-events-auto transition-all duration-300 transform translate-y-2 opacity-0`;
      toast.innerHTML = `
        <i class="fa-solid ${icon} ${iconColor} text-base"></i>
        <span class="font-medium flex-1">${message}</span>
      `;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    /* ===================================================================
       INICIALIZAÇÃO NO CARREGAMENTO DA PÁGINA
       =================================================================== */
    window.onload = function() {
      updateMetricsUI();
      renderHistoryTable();
      calculateFees();
      updateSimulation();
      
      // Tentar validar endpoint em nuvem
      checkBackendHealth();
    };
  </script>
</body>
</html>
