<!DOCTYPE html>
<html lang="pt" class="dark h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>InvestMoz PRO - Gestão de Investimentos e Levantamentos</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              800: '#065f46',
              900: '#064e3b',
              950: '#022c22',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }

    /* Glassmorphism & Visual Polish */
    .glass-card {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(51, 65, 85, 0.4);
    }

    .glow-brand {
      box-shadow: 0 0 25px -5px rgba(16, 185, 129, 0.2);
    }
    
    .glow-brand-lg {
      box-shadow: 0 0 35px -5px rgba(16, 185, 129, 0.35);
    }

    /* Pulse animation for live connectivity */
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.4; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulse-indicator {
      animation: pulse-ring 2s infinite ease-in-out;
    }
  </style>
</head>

<body class="bg-[#030712] text-slate-100 font-sans min-h-full flex flex-col antialiased selection:bg-brand-500 selection:text-slate-950">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none max-w-sm w-full"></div>

  <!-- Header / Navigation Bar -->
  <header class="sticky top-0 z-40 bg-[#090d16]/80 backdrop-blur-md border-b border-slate-800/80 px-4 sm:px-8 py-3.5 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-brand-500 to-teal-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-brand-500/20">
        <i class="fa-solid fa-chart-line"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="font-extrabold text-lg leading-tight tracking-wide text-white">InvestMoz</h1>
          <span class="text-[10px] font-bold tracking-wider text-brand-400 uppercase px-2 py-0.5 rounded-full bg-brand-950/80 border border-brand-800/60">MZ Dashboard</span>
        </div>
        <p class="text-[11px] text-slate-400">Sistema Integrado de Gestão de Levantamentos</p>
      </div>
    </div>

    <!-- Backend Status & User Profile -->
    <div class="flex items-center space-x-3 sm:space-x-4">
      
      <!-- Backend Status Indicator -->
      <div id="apiStatusBadge" onclick="checkBackendHealth()" class="cursor-pointer flex items-center bg-slate-900 hover:bg-slate-800 transition-colors rounded-full px-3 py-1.5 border border-slate-800 text-xs text-slate-300" title="Clique para retestar a API">
        <span id="apiStatusDot" class="w-2.5 h-2.5 rounded-full bg-amber-400 pulse-indicator mr-2"></span>
        <span id="apiStatusText" class="text-[11px] font-medium">A conectar Render API...</span>
      </div>

      <!-- User Info -->
      <div class="flex items-center space-x-3 border-l border-slate-800 pl-3 sm:pl-4">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-950 to-slate-900 border border-brand-500/30 flex items-center justify-center font-bold text-brand-400 text-sm shadow-inner">
          JM
        </div>
        <div class="hidden sm:block text-left">
          <div class="text-xs font-semibold text-slate-200">João Mondlane</div>
          <div class="text-[10px] text-brand-400 flex items-center gap-1">
            <i class="fa-solid fa-circle-check text-[9px]"></i> Conta Verificada
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Dashboard Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

    <!-- BANNER DE CONEXÃO COM BACKEND -->
    <div id="apiInfoBanner" class="hidden bg-slate-900/90 border border-brand-500/30 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-center space-x-3">
        <div class="p-2 rounded-lg bg-brand-950 text-brand-400 border border-brand-800">
          <i class="fa-solid fa-server text-base"></i>
        </div>
        <div>
          <span class="font-bold text-white block">Servidor Render Conectado!</span>
          <span class="text-slate-400 text-[11px]">Backend ativo em <code class="text-brand-400 font-mono">https://sistema-levantamento-backend.onrender.com</code></span>
        </div>
      </div>
      <button onclick="document.getElementById('apiInfoBanner').classList.add('hidden')" class="text-slate-400 hover:text-white text-xs px-2 py-1">
        <i class="fa-solid fa-xmark mr-1"></i> Fechar aviso
      </button>
    </div>

    <!-- SECÇÃO 1: ESTATÍSTICAS E SALDOS -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Card: Saldo Total -->
      <div class="glass-card rounded-2xl p-5 relative overflow-hidden group hover:border-brand-500/50 transition-all glow-brand">
        <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-brand-500/10 rounded-full blur-2xl group-hover:bg-brand-500/20 transition-all"></div>
        <div class="flex justify-between items-start mb-3">
          <div>
            <span class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Saldo Disponível</span>
            <div class="flex items-baseline space-x-1.5 mt-1">
              <h2 id="totalBalanceDisplay" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-mono">145.850,00</h2>
              <span class="text-xs font-bold text-brand-400">MT</span>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-brand-950/80 border border-brand-800/60 text-brand-400 flex items-center justify-center shadow-lg shadow-brand-950">
            <i class="fa-solid fa-wallet text-lg"></i>
          </div>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-3 border-t border-slate-800/80">
          <span class="text-slate-400">Moeda: <strong class="text-slate-200">Metical (MZN)</strong></span>
          <span class="text-brand-400 font-semibold bg-brand-950/90 px-2 py-0.5 rounded border border-brand-800/40">Ativo</span>
        </div>
      </div>

      <!-- Card: Rendimento Acumulado -->
      <div class="glass-card rounded-2xl p-5 relative overflow-hidden group hover:border-brand-500/50 transition-all">
        <div class="flex justify-between items-start mb-3">
          <div>
            <span class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Rendimento Acumulado</span>
            <div class="flex items-center space-x-2 mt-1">
              <h2 id="yieldPercentageDisplay" class="text-2xl sm:text-3xl font-extrabold text-brand-400 tracking-tight font-mono">+18.4%</h2>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 text-brand-400 flex items-center justify-center">
            <i class="fa-solid fa-arrow-trend-up text-lg"></i>
          </div>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-3 border-t border-slate-800/80">
          <span class="text-slate-400">Lucro Lucrado:</span>
          <span id="profitDisplay" class="text-slate-200 font-bold font-mono">+22.710,00 MT</span>
        </div>
      </div>

      <!-- Card: Levantamentos Pendentes -->
      <div class="glass-card rounded-2xl p-5 relative overflow-hidden group hover:border-amber-500/50 transition-all">
        <div class="flex justify-between items-start mb-3">
          <div>
            <span class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Levantamentos Pendentes</span>
            <div class="flex items-baseline space-x-2 mt-1">
              <h2 id="pendingCountDisplay" class="text-2xl sm:text-3xl font-extrabold text-amber-400 tracking-tight font-mono">2</h2>
              <span class="text-xs text-slate-400">pedidos</span>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-950/50 border border-amber-800/40 text-amber-400 flex items-center justify-center">
            <i class="fa-solid fa-hourglass-half text-lg"></i>
          </div>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-3 border-t border-slate-800/80">
          <span class="text-slate-400">Total em Análise:</span>
          <span id="pendingAmountDisplay" class="text-amber-300 font-bold font-mono">12.500,00 MT</span>
        </div>
      </div>

      <!-- Card: Total Resgatado -->
      <div class="glass-card rounded-2xl p-5 relative overflow-hidden group hover:border-brand-500/50 transition-all">
        <div class="flex justify-between items-start mb-3">
          <div>
            <span class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Total Já Processado</span>
            <div class="flex items-baseline space-x-2 mt-1">
              <h2 id="completedTotalDisplay" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-mono">84.200,00</h2>
              <span class="text-xs font-bold text-slate-400">MT</span>
            </div>
          </div>
          <div class="w-10 h-10 rounded-xl bg-slate-800/80 border border-slate-700/60 text-blue-400 flex items-center justify-center">
            <i class="fa-solid fa-circle-check text-lg"></i>
          </div>
        </div>
        <div class="flex items-center justify-between text-[11px] pt-3 border-t border-slate-800/80">
          <span class="text-slate-400">Total Concluídos:</span>
          <span id="completedCountDisplay" class="text-slate-200 font-bold">3 transações</span>
        </div>
      </div>

    </section>

    <!-- SECÇÃO 2: FORMULÁRIO DE LEVANTAMENTO & SIMULADOR -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Form de Levantamento (7 colunas) -->
      <div class="lg:col-span-7 glass-card rounded-2xl p-5 sm:p-7 shadow-2xl relative">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
          <div>
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-money-bill-transfer text-brand-400"></i> Solicitar Levantamento
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">Escolha o método de recepção e indique os dados da conta.</p>
          </div>
          <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] bg-brand-950/80 text-brand-400 font-semibold px-3 py-1 rounded-full border border-brand-800/60">
            <i class="fa-solid fa-shield text-[10px]"></i> Processamento Seguro
          </span>
        </div>

        <form id="withdrawalForm" onsubmit="handleWithdrawalSubmit(event)" class="space-y-5">
          
          <!-- Seleção de Método -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              1. Selecione o Método de Recebimento
            </label>
            <div class="grid grid-cols-3 gap-3">
              
              <!-- M-Pesa -->
              <label class="cursor-pointer">
                <input type="radio" name="paymentMethod" value="M-Pesa" class="peer hidden" checked onchange="updateAccountFields()">
                <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 peer-checked:border-brand-500 peer-checked:bg-brand-950/40 peer-checked:text-brand-400 hover:bg-slate-800/80 transition-all text-center flex flex-col items-center justify-center space-y-1.5 h-full">
                  <div class="w-9 h-9 rounded-full bg-red-600/20 text-red-500 flex items-center justify-center font-black text-xs border border-red-500/30">
                    M
                  </div>
                  <span class="text-xs font-bold text-slate-200">M-Pesa</span>
                  <span class="text-[10px] text-slate-400">Vodacom</span>
                </div>
              </label>

              <!-- e-Mola -->
              <label class="cursor-pointer">
                <input type="radio" name="paymentMethod" value="e-Mola" class="peer hidden" onchange="updateAccountFields()">
                <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 peer-checked:border-brand-500 peer-checked:bg-brand-950/40 peer-checked:text-brand-400 hover:bg-slate-800/80 transition-all text-center flex flex-col items-center justify-center space-y-1.5 h-full">
                  <div class="w-9 h-9 rounded-full bg-orange-500/20 text-orange-400 flex items-center justify-center font-black text-xs border border-orange-500/30">
                    e
                  </div>
                  <span class="text-xs font-bold text-slate-200">e-Mola</span>
                  <span class="text-[10px] text-slate-400">Movitel</span>
                </div>
              </label>

              <!-- Banco -->
              <label class="cursor-pointer">
                <input type="radio" name="paymentMethod" value="Transferência Bancária" class="peer hidden" onchange="updateAccountFields()">
                <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 peer-checked:border-brand-500 peer-checked:bg-brand-950/40 peer-checked:text-brand-400 hover:bg-slate-800/80 transition-all text-center flex flex-col items-center justify-center space-y-1.5 h-full">
                  <div class="w-9 h-9 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center text-xs border border-blue-500/30">
                    <i class="fa-solid fa-building-columns"></i>
                  </div>
                  <span class="text-xs font-bold text-slate-200">Banco</span>
                  <span class="text-[10px] text-slate-400">NIB / Conta</span>
                </div>
              </label>

            </div>
          </div>

          <!-- Campos do Formulário -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Valor do Levantamento -->
            <div>
              <label for="amountInput" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                2. Valor a Resgatar (MT)
              </label>
              <div class="relative">
                <input 
                  type="number" 
                  id="amountInput" 
                  min="100" 
                  step="50"
                  placeholder="Ex: 5000" 
                  required
                  oninput="calculateFees()"
                  class="w-full bg-slate-950/90 border border-slate-700/80 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 rounded-xl px-4 py-3 text-white placeholder-slate-500 outline-none font-mono font-bold transition-all text-base"
                >
                <div class="absolute right-3 top-3 text-xs font-bold text-slate-400 bg-slate-800 px-2 py-1 rounded border border-slate-700">
                  MZN
                </div>
              </div>
              <div class="flex justify-between items-center text-[11px] text-slate-400 mt-1.5">
                <span>Mínimo: 100 MT</span>
                <button type="button" onclick="setMaxAmount()" class="text-brand-400 hover:underline font-semibold">Tudo (<span id="maxBalanceBtnText">145.850 MT</span>)</button>
              </div>
            </div>

            <!-- Número / Conta -->
            <div>
              <label id="accountLabel" for="accountInput" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                3. Número de Telefone (84/85)
              </label>
              <div class="relative">
                <input 
                  type="text" 
                  id="accountInput" 
                  placeholder="841234567" 
                  required
                  class="w-full bg-slate-950/90 border border-slate-700/80 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 rounded-xl px-4 py-3 text-white placeholder-slate-500 outline-none font-mono font-bold transition-all text-base"
                >
                <div class="absolute right-3 top-3.5 text-slate-500">
                  <i id="accountIcon" class="fa-solid fa-mobile-screen"></i>
                </div>
              </div>
              <p id="accountHelpText" class="text-[11px] text-slate-500 mt-1.5">Apenas números registados na Vodacom Mozambique.</p>
            </div>

          </div>

          <!-- Resumo de Taxas e Valor Líquido -->
          <div class="bg-slate-950/80 rounded-xl p-4 border border-slate-800 space-y-2 text-xs">
            <div class="flex justify-between text-slate-400">
              <span>Taxa de Processamento (1.5%):</span>
              <span id="feeDisplay" class="text-slate-200 font-mono font-semibold">0,00 MT</span>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>Tempo de Liquidação Estimado:</span>
              <span id="timeEstimate" class="text-brand-400 font-medium">Instantâneo (Até 15 min)</span>
            </div>
            <div class="border-t border-slate-800/80 pt-2 flex justify-between items-center font-bold">
              <span class="text-slate-200">Valor Líquido a Receber:</span>
              <span id="netAmountDisplay" class="text-brand-400 font-mono text-base font-extrabold">0,00 MT</span>
            </div>
          </div>

          <!-- Botão Submeter -->
          <button 
            type="submit" 
            id="submitBtn"
            class="w-full bg-gradient-to-r from-brand-500 to-teal-500 hover:from-brand-400 hover:to-teal-400 text-slate-950 font-extrabold py-3.5 px-6 rounded-xl shadow-lg shadow-brand-500/20 active:scale-[0.99] transition-all flex items-center justify-center space-x-2 text-base"
          >
            <span id="btnText">Confirmar e Solicitar Levantamento</span>
            <div id="btnSpinner" class="hidden animate-spin rounded-full h-5 w-5 border-2 border-slate-950 border-t-transparent"></div>
          </button>

        </form>
      </div>

      <!-- Simulador e Dicas (5 colunas) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Simulador de Reinvestimento -->
        <div class="glass-card rounded-2xl p-5 shadow-xl">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i class="fa-solid fa-calculator text-brand-400"></i> Simulador de Rendimentos
            </h3>
            <span class="text-[10px] text-slate-400 bg-slate-800 px-2 py-0.5 rounded">Retorno de ~1.8%/mês</span>
          </div>
          <p class="text-xs text-slate-400 mb-4">Simule o crescimento do seu saldo mantendo-o aplicado na InvestMoz.</p>

          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs text-slate-300 mb-2">
                <span>Tempo de Retenção:</span>
                <span id="monthsVal" class="font-bold text-brand-400 font-mono">6 Meses</span>
              </div>
              <input 
                type="range" 
                id="monthsRange" 
                min="1" 
                max="24" 
                value="6" 
                oninput="updateSimulation()"
                class="w-full accent-brand-500 bg-slate-950 h-2 rounded-lg cursor-pointer"
              >
              <div class="flex justify-between text-[10px] text-slate-500 mt-1 font-mono">
                <span>1 mês</span>
                <span>12 meses</span>
                <span>24 meses</span>
              </div>
            </div>

            <!-- Projeção Resultado -->
            <div class="p-3.5 bg-slate-950/90 rounded-xl border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Saldo Projetado:</span>
                <span id="projectedBalance" class="text-lg font-black text-brand-400 font-mono">162.145,20 MT</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block">Lucro Adicional:</span>
                <span id="projectedProfit" class="text-xs font-bold text-teal-300 font-mono">+16.295,20 MT</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Guia de Informação das Redes em MZ -->
        <div class="glass-card rounded-2xl p-5 border-slate-800/80">
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
            <i class="fa-solid fa-circle-info text-brand-400"></i> Informação Importante para Moçambique
          </h4>
          <ul class="space-y-2 text-xs text-slate-400 leading-relaxed">
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-brand-400 mt-0.5"></i>
              <span><strong>M-Pesa e e-Mola:</strong> Processamento automático imediato para montantes até 25.000,00 MT.</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-brand-400 mt-0.5"></i>
              <span><strong>Bancos Locais:</strong> Suporte para Millennium BIM, BCI, Standard Bank, Absa e Moza Banco.</span>
            </li>
            <li class="flex items-start gap-2">
              <i class="fa-solid fa-check text-brand-400 mt-0.5"></i>
              <span><strong>Taxa Única:</strong> Cobramos apenas 1.5% para cobrir encargos de rede de liquidação.</span>
            </li>
          </ul>
        </div>

      </div>

    </section>

    <!-- SECÇÃO 3: HISTÓRICO DE TRANSAÇÕES -->
    <section class="glass-card rounded-2xl p-5 sm:p-7 shadow-2xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800">
        <div>
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-clock-rotate-left text-brand-400"></i> Histórico de Transações
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Lista detalhada de resgates e movimentações financeiras.</p>
        </div>

        <!-- Filtros e Busca -->
        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Campo Busca -->
          <div class="relative">
            <input 
              type="text" 
              id="searchHistory" 
              placeholder="Pesquisar id, conta..." 
              oninput="renderHistoryTable()"
              class="bg-slate-950 border border-slate-700/80 text-xs text-white rounded-xl pl-8 pr-3 py-2 outline-none focus:border-brand-500 w-36 sm:w-48 font-mono"
            >
            <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-500 text-xs"></i>
          </div>

          <!-- Filtro Método -->
          <select 
