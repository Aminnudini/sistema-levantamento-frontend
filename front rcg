  <script>
    /* ===================================================================
       CONFIGURAÇÕES E ESTADO DA APLICAÇÃO
       =================================================================== */
    const BACKEND_URL = "https://sistema-levantamento-backend.onrender.com";

    // Estado local sincronizado
